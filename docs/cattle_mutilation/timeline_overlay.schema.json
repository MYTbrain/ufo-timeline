{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/animal-mutilation-timeline-overlay.schema.json",
  "title": "Animal Mutilation Timeline Overlay",
  "description": "Privacy-safe context overlay for the UFO Timeline. Unreviewed source reports remain clearly labelled, do not assert a cause, and are never UFO craft-trace endpoints.",
  "type": "object",
  "required": [
    "type",
    "name",
    "schema_version",
    "event_domain",
    "release_mode",
    "trace_eligible",
    "trace_role",
    "causality",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "name": {
      "const": "Animal Mutilation Reports"
    },
    "schema_version": {
      "const": "animal-mutilation-timeline-overlay-v1.1.0"
    },
    "event_domain": {
      "const": "animal_mutilation"
    },
    "release_mode": {
      "enum": [
        "reported_unreviewed",
        "review_ledger"
      ]
    },
    "trace_eligible": {
      "const": false
    },
    "trace_role": {
      "const": "context_only"
    },
    "causality": {
      "const": "not_asserted"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": "string",
          "pattern": "^animal_mutilation:ami_[0-9a-f]{24}$"
        },
        "geometry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "items": false
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "properties": {
          "$ref": "#/$defs/properties"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "properties": {
                "properties": {
                  "privacy_level": {
                    "enum": [
                      "internal_only",
                      "withheld"
                    ]
                  }
                },
                "required": [
                  "privacy_level"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "geometry": {
                "type": "object"
              }
            },
            "required": [
              "geometry"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "properties": {
                  "privacy_level": {
                    "enum": [
                      "public_exact",
                      "public_generalized"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "properties": {
                "properties": {
                  "privacy_level": {
                    "const": "public_generalized"
                  }
                },
                "required": [
                  "privacy_level"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "properties": {
                  "location_precision": {
                    "enum": [
                      "locality",
                      "county",
                      "state",
                      "country",
                      "approximate",
                      "unknown"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "required": [
        "animal_mutilation_event_id",
        "source_incident_id",
        "source_incident_sha256",
        "event_domain",
        "record_type",
        "claim_label",
        "status",
        "evidence_status",
        "source_status",
        "title",
        "summary",
        "date_start",
        "date_end",
        "date_precision",
        "location_label",
        "location_precision",
        "privacy_level",
        "uncertainty",
        "normalized_common_names",
        "reported_taxon_keys",
        "species_groups",
        "evidence_excerpts",
        "source_refs",
        "content_warning",
        "trace_eligible",
        "trace_role",
        "causality"
      ],
      "properties": {
        "animal_mutilation_event_id": {
          "type": "string",
          "pattern": "^ami_[0-9a-f]{24}$"
        },
        "source_incident_id": {
          "type": "string",
          "pattern": "^cmi_[0-9a-f]{24}$"
        },
        "source_incident_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_decision_id": {
          "type": "string",
          "pattern": "^amrd_[0-9a-f]{24}$"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "event_domain": {
          "const": "animal_mutilation"
        },
        "record_type": {
          "const": "mutilation_case"
        },
        "claim_label": {
          "const": "Reported animal mutilation"
        },
        "status": {
          "type": "string",
          "enum": [
            "reported_unreviewed",
            "lead",
            "documented_report",
            "corroborated",
            "explained_natural",
            "explained_human",
            "contested",
            "unresolved",
            "retracted"
          ]
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "reported_unreviewed",
            "reviewed"
          ]
        },
        "source_status": {
          "type": "string",
          "enum": [
            "lead",
            "documented_report",
            "corroborated",
            "explained_natural",
            "explained_human",
            "contested",
            "unresolved",
            "retracted"
          ]
        },
        "title": {
          "const": "Reported animal mutilation"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "date_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "date_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "date_precision": {
          "type": "string",
          "enum": [
            "exact_time",
            "exact_day",
            "month",
            "season",
            "year",
            "range",
            "approximate",
            "unknown"
          ]
        },
        "location_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "location_precision": {
          "type": "string",
          "enum": [
            "exact_site",
            "parcel",
            "road_segment",
            "locality",
            "county",
            "state",
            "country",
            "approximate",
            "unknown"
          ]
        },
        "privacy_level": {
          "type": "string",
          "enum": [
            "public_exact",
            "public_generalized",
            "internal_only",
            "withheld"
          ]
        },
        "uncertainty": {
          "type": "object",
          "required": [
            "date_precision",
            "location_precision",
            "privacy_generalized",
            "coordinates_available"
          ],
          "properties": {
            "date_precision": {
              "type": "string",
              "enum": [
                "exact_time",
                "exact_day",
                "month",
                "season",
                "year",
                "range",
                "approximate",
                "unknown"
              ]
            },
            "location_precision": {
              "type": "string",
              "enum": [
                "exact_site",
                "parcel",
                "road_segment",
                "locality",
                "county",
                "state",
                "country",
                "approximate",
                "unknown"
              ]
            },
            "privacy_generalized": {
              "type": "boolean"
            },
            "coordinates_available": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "normalized_common_names": {
          "$ref": "#/$defs/string_set"
        },
        "reported_taxon_keys": {
          "$ref": "#/$defs/string_set"
        },
        "species_groups": {
          "$ref": "#/$defs/string_set"
        },
        "evidence_excerpts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "content_warning": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "trace_eligible": {
          "const": false
        },
        "trace_role": {
          "const": "context_only"
        },
        "causality": {
          "const": "not_asserted"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "reported_unreviewed"
              }
            },
            "required": [
              "evidence_status"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "reported_unreviewed"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "review_decision_id"
                  ]
                },
                {
                  "required": [
                    "reviewed_on"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "reviewed"
              }
            },
            "required": [
              "evidence_status"
            ]
          },
          "then": {
            "required": [
              "review_decision_id",
              "reviewed_on"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_ref": {
      "type": "object",
      "required": [
        "source_id",
        "locator",
        "source_hash"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
