{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ufo-timeline-context-evidence-assertion-v1.0.0",
  "type": "object",
  "required": ["schemaId", "assertionId", "caseId", "domain", "fieldName", "value", "sourceIds", "sourceLocators", "confidence", "polarity", "evidenceSha256", "waveId", "assertedAt"],
  "properties": {
    "schemaId": {"const": "ufo-timeline-context-evidence-assertion-v1.0.0"},
    "assertionId": {"type": "string", "pattern": "^cea_[a-f0-9]{16,64}$"},
    "caseId": {"type": "string", "pattern": "^(cc|ami)_[a-f0-9]+$"},
    "domain": {"enum": ["crop_circle", "animal_mutilation"]},
    "fieldName": {"enum": ["source_case_identifier", "public_title", "public_summary", "occurrence_date", "formation_date", "discovery_date", "photography_date", "catalog_date", "publication_date", "death_interval", "report_date", "investigation_date", "latitude", "longitude", "coordinate_uncertainty_m", "coordinate_method", "location_label", "witnesses", "morphology", "injuries", "animal_species", "victim_count", "crop_type", "primary_classification", "secondary_classification", "associated_claim", "dedup_cluster_id", "duplicate_of_case_id", "legal_publication_restriction"]},
    "value": {"type": ["string", "number", "boolean", "array", "object"]},
    "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src_[a-f0-9]{16,64}$"}, "uniqueItems": true},
    "sourceLocators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "locator"],
        "properties": {
          "sourceId": {"type": "string", "pattern": "^src_[a-f0-9]{16,64}$"},
          "locator": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "polarity": {"enum": ["supports", "contradicts", "reports", "unknown"]},
    "evidenceSha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "waveId": {"type": "string", "pattern": "^wave-[0-9]{3}-[a-z0-9-]+$"},
    "assertedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
