# Reproducible byte-for-byte checkouts on Windows, macOS, and Linux.
* text=auto eol=lf

*.bin binary
*.gz binary
*.parquet binary
*.zip binary

# These six deployed files contain mixed line endings. Preserve their exact
# bytes; normalizing them would change the production/source integrity hash.
webapp/static_public/index.html -text
