# Cloudflare Pages cache policy for UFO Timeline static deployment.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-store
  Service-Worker-Allowed: /

/startup_profile_worker.js
  Cache-Control: public, max-age=0, must-revalidate

